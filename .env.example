# Variáveis de ambiente para desenvolvimento local
# NÃO commitar o arquivo .env com dados reais para o GitHub

# Banco de dados (para produção no Railway, usar a URL do PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Chave secreta JWT (troque por uma chave forte em produção!)
# SECRET_KEY=sua_chave_secreta_super_segura_aqui
